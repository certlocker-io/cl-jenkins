<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Name" field="name"><f:textbox/></f:entry>
  <f:entry title="CertLocker base URL (HTTPS)" field="url"><f:textbox/></f:entry>
  <f:entry title="OpenID Connect id token credential ID" field="credentialsId"><f:textbox/></f:entry>
  <f:entry title="Default Trust account ID (optional)" field="account"><f:textbox/></f:entry>
  <f:repeatableDeleteButton/>
</j:jelly>
